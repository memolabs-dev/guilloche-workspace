{% set names = { priorites: 'Priorités', atelier: 'Atelier', panorama: 'Panorama' } %}
{% extends 'layout/exploration.html.twig' %}
{% import 'components/ui.html.twig' as ui %}
{% block body %}
  <header class="exp-heading">
    <div>
      <h1>Vos missions</h1>
      <p>
        {{ direction == 'priorites'
          ? 'Savoir ce qui vous attend. Avancer, une étape à la fois.'
          : direction == 'atelier'
            ? 'Vos dossiers, leurs échéances et les prochaines décisions.'
            : 'Le fil de votre accompagnement, du dossier au document.' }}
      </p>
    </div><span class="exp-account">{{ ui.icon('building') }}Atelier Rivage</span>
  </header>
  <div
    data-controller="exploration"
    data-exploration-loading-message-value="Mise à jour des missions…"
    data-action="turbo:before-fetch-request->exploration#start turbo:before-fetch-response->exploration#response turbo:fetch-request-error->exploration#failure turbo:frame-missing->exploration#missing turbo:frame-load->exploration#loaded unhandledrejection@window->exploration#handledRejection turbo:before-cache@document->exploration#reset"
  >
    <div
      class="exp-feedback"
      role="status"
      aria-live="polite"
      data-exploration-target="feedback"
    ></div>
    <div class="exp-error" hidden role="alert" data-exploration-target="error">
      <p>
        Les missions n’ont pas pu être chargées. Votre vue est conservée.
      </p><button
        class="exp-button exp-button--quiet"
        type="button"
        data-action="exploration#retry"
      >
        Réessayer
      </button>
    </div>
    <turbo-frame
      id="exploration-results"
      data-turbo-action="advance"
      data-exploration-target="frame"
    >
      <div
        class="exp-workspace {{ selected ? 'has-selection' : '' }}"
        data-query="{{ query }}"
        data-status="{{ status }}"
        data-selected="{{ selected ? selected.id : '' }}"
      >
        <form
          class="exp-toolbar"
          method="get"
          action="{{ path('exploration_missions', { direction: direction }) }}"
        >
          <div class="exp-search">
            <label class="sr-only" for="exp-search">Rechercher une mission</label>{{ ui.icon('search') }}<input
              type="search"
              id="exp-search"
              name="q"
              value="{{ query }}"
              maxlength="100"
              placeholder="Rechercher une mission…"
              data-exploration-target="search"
            />
          </div>
          <div class="exp-filter">
            <label for="exp-status">État</label><select id="exp-status" name="status">
              {% for key, label in {
                '': 'Tous les états',
                action: 'À votre tour',
                progress: 'En cours',
                done: 'Terminées'
              } %}
                <option value="{{ key }}" {{ key == status ? 'selected' : '' }}>
                  {{ label }}
                </option>
              {% endfor %}
            </select>
          </div><button class="exp-button exp-button--quiet" type="submit">Filtrer</button>{% if
            selected %}
            <input type="hidden" name="selected" value="{{ selected.id }}" />
          {% endif %}<button
            class="exp-clear"
            type="button"
            data-exploration-target="clear"
            data-action="exploration#clear"
            hidden
          >
            Effacer
          </button>
        </form>
        <div class="exp-data">
          <div class="exp-skeleton" hidden aria-hidden="true" data-exploration-target="skeleton">
            <div class="exp-skeleton-list">
              {% for i in 1..5 %}
                <div>
                  <span class="sk sk--name"></span><span class="sk sk--short"></span><span
                    class="sk sk--step"
                  >

                  </span>
                </div>
              {% endfor %}
            </div>
            <div class="exp-skeleton-reader">
              <span class="sk sk--name"></span><span class="sk sk--short"></span><span
                class="sk sk--step"
              >

              </span><span class="sk sk--name"></span><span class="sk sk--step"></span>
            </div>
          </div>
          <div class="exp-layout" data-exploration-target="content">
            <section class="exp-master" aria-labelledby="exp-results">
              <div class="exp-list-heading">
                <h2 id="exp-results" tabindex="-1" data-exploration-target="summary">
                  {{ missions|length }} mission{{ (missions|length) > 1 ? 's' : '' }}
                </h2><span>Suivi de vos dossiers</span>
              </div>
              {% if missions %}
                {% if direction == 'atelier' %}
                  <table class="exp-table">
                    <caption class="sr-only">
                      Missions et prochaines étapes
                    </caption>
                    <thead>
                      <tr>
                        <th>Mission</th>
                        <th>État</th>
                        <th>Échéance</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for mission in missions %}
                        <tr
                          class="{{ selected and selected.id == mission.id ? 'is-selected' : '' }}"
                        >
                          <td>
                            <a
                              class="exp-mission-link"
                              href="{{
                              path(
                                'exploration_missions',
                                {
                                  direction: direction,
                                  q: query,
                                  status: status,
                                  selected: mission.id
                                }
                              )
                              }}"
                              aria-current="{{
                              selected and selected.id == mission.id
                                ? 'true'
                                : 'false'
                              }}"
                            >
                              {{ mission.title }}
                            </a><span class="exp-row-step">{{ mission.step }}</span>
                            <span class="exp-mobile-date">{{ mission.date }}</span>
                          </td>
                          <td><twig:Ui:Status :code="mission.status" :text="mission.label" /></td>
                          <td class="exp-date">{{ mission.date }}</td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                {% else %}
                  {% set groups = direction == 'priorites'
                    ? {
                      action: 'À votre tour',
                      progress: 'Avec votre interlocuteur',
                      done: 'Terminée'
                    }
                    : { '': 'Toutes les missions' }
                  %}
                  {% for code, label in groups %}
                    {% set group = code ? missions|filter(m => m.status == code) : missions %}
                    {% if group %}
                      <div class="exp-group">
                        {% if direction == 'priorites' %}
                          <h3>{{ label }}<span>{{ group|length }}</span></h3>
                        {% endif %}
                        <ul class="exp-mission-list">
                          {% for mission in group %}
                            <li
                              class="exp-mission {{
                              selected and selected.id == mission.id
                                ? 'is-selected'
                                : ''
                              }}"
                            >
                              <div class="exp-mission-top">
                                <a
                                  class="exp-mission-link"
                                  href="{{
                                  path(
                                    'exploration_missions',
                                    {
                                      direction: direction,
                                      q: query,
                                      status: status,
                                      selected: mission.id
                                    }
                                  )
                                  }}"
                                  aria-current="{{
                                  selected and selected.id == mission.id
                                    ? 'true'
                                    : 'false'
                                  }}"
                                >
                                  {{ mission.title }}
                                </a>{% if selected and selected.id == mission.id %}
                                  <span class="exp-selected-label">
                                    {{ ui.icon('check') }}<span class="sr-only">Sélectionnée</span>
                                  </span>
                                {% endif %}
                              </div>
                              <p class="exp-row-step">
                                {{ mission.step }}
                              </p>
                              <div class="exp-mission-meta">
                                <twig:Ui:Status :code="mission.status" :text="mission.label" /><span
                                >
                                  {{ mission.date }}
                                </span>
                              </div>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% else %}
                <div class="exp-empty">
                  {{ ui.icon('search') }}<h3>Aucune mission trouvée</h3>
                  <p>
                    Essayez un autre mot ou affichez tous vos dossiers.
                  </p><a
                    class="exp-button exp-button--quiet"
                    href="{{ path('exploration_missions', { direction: direction }) }}"
                  >
                    Effacer les filtres
                  </a>
                </div>
              {% endif %}
            </section>
            <aside class="exp-reader" aria-label="Lecture de la mission">
              {% if selected %}
                <a
                  class="exp-back"
                  href="{{
                  path(
                    'exploration_missions',
                    { direction: direction, q: query, status: status }
                  )
                  }}"
                >
                  {{ ui.icon('arrow', 'exp-back-icon') }}Retour aux missions
                </a><article class="exp-detail">
                  <div class="exp-detail-title">
                    <twig:Ui:Status :code="selected.status" :text="selected.label" />
                    <h2 id="exp-mission-title" tabindex="-1" data-exploration-target="focus">
                      {{ selected.title }}
                    </h2>
                    <p>
                      {{ selected.category }}<span class="exp-ref">{{ selected.reference }}</span>
                    </p>
                  </div>
                  <section class="exp-next">
                    <h3>Votre prochaine étape</h3>
                    <p>
                      {{ selected.step }}
                    </p><span>Échéance le {{ selected.date }}</span>{% if
                      selected.id == 1 and documents %}
                      <a
                        class="exp-button"
                        href="{{ path('document_detail', { id: documents[0].id }) }}"
                        data-turbo-frame="_top"
                      >
                        Consulter la synthèse{{ ui.icon('arrow') }}
                      </a>
                    {% endif %}
                  </section>
                  <section class="exp-linked">
                    <h3>Documents associés<span>{{ documents|length }}</span></h3>
                    {% for document in documents %}
                      <a
                        href="{{ path('document_detail', { id: document.id }) }}"
                        data-turbo-frame="_top"
                      >
                        {{ ui.icon('file') }}<span>
                          <strong>{{ document.title }}</strong><small>{{ document.date }}</small>
                        </span>{{ ui.icon('chevron') }}
                      </a>
                    {% else %}
                      <p>
                        Aucun document associé pour le moment.
                      </p>
                    {% endfor %}
                  </section>
                  <div class="exp-advisor">
                    <span class="exp-avatar">{{ ui.icon('help') }}</span><div>
                      <small>Votre interlocuteur</small><strong>{{ selected.advisor }}</strong>
                    </div>
                  </div>
                </article>
              {% else %}
                <div class="exp-reader-empty">
                  {{ ui.icon('briefcase') }}<h2>La suite commence ici.</h2>
                  <p>
                    Choisissez une mission pour lire sa prochaine étape et retrouver ses documents.
                  </p>
                </div>
              {% endif %}
            </aside>
          </div>
        </div>
      </div>
    </turbo-frame>
    <details class="exp-motion">
      <summary>
        Voir les états et le mouvement
      </summary>
      <p>
        Prévisualisation des composants. Aucun chargement serveur n’est simulé dans le parcours.
      </p>
      <div
        class="exp-state-buttons"
        hidden
        data-exploration-target="previewControls"
        role="group"
        aria-label="État à prévisualiser"
      >
        {% for key, label in {
          full: 'Contenu',
          loading: 'Skeleton',
          empty: 'Vide',
          error: 'Erreur'
        } %}
          <button
            type="button"
            class="exp-button exp-button--quiet"
            data-action="exploration#preview"
            data-exploration-state-param="{{ key }}"
            aria-pressed="{{ key == 'full' ? 'true' : 'false' }}"
          >
            {{ label }}
          </button>
        {% endfor %}
      </div>
      <div class="exp-state-preview" data-exploration-target="preview" aria-live="polite">
        <div data-state="full">
          <strong>Valider la synthèse</strong><p>
            Le contenu de la région est disponible.
          </p>
        </div>
        <div data-state="loading" hidden>
          <span class="sr-only">Exemple de chargement</span><div
            class="exp-preview-skeleton"
            aria-hidden="true"
          >
            <span class="sk sk--name"></span><span class="sk sk--step"></span><span
              class="sk sk--short"
            >

            </span>
          </div>
        </div>
        <div data-state="empty" hidden>
          <strong>Aucune mission à afficher</strong><p>
            Les filtres peuvent être modifiés.
          </p>
        </div>
        <div data-state="error" hidden>
          <strong>Chargement indisponible</strong><p>
            Le message propose une nouvelle tentative dans le parcours réel.
          </p>
        </div>
      </div>
      <p class="exp-motion-note">
        Réponses des contrôles : 120 ms. Changement de fiche : 180 ms. Skeleton après 140 ms de
        requête. Mouvement réduit respecté.
      </p>
    </details>
  </div>
  <footer class="exp-footer">
    <span>Exploration {{ names[direction] }} — direction non validée</span><a href="{{ path('design_system') }}">Catalogue
      actuel</a>
  </footer>
{% endblock %}
