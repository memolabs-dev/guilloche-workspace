{% extends 'base.html.twig' %}
{% block title %}Vue d’ensemble{% endblock %}
{% block body %}
  {% set pending = missions|filter(mission => mission.awaitingClient) %}
  {% set running = missions|filter(mission => mission.status.value != 'done') %}
  {% set next = pending|first %}

  <div class="page-head">
    <div>
      <h1>Bonjour Alexandre.</h1>
      <p>
        {{ running|length }} missions avancent, <a class="ui-link" href="{{ path('app_mission_index', { status: 'action' }) }}">{{ pending|length }} attendent votre geste</a>.
        Prochaine échéance le <span class="ui-numeric">{{ next.dueOn|short_date }}</span>.
      </p>
    </div>
  </div>

  <section class="coupon" aria-labelledby="coupon-title">
    <twig:Ui:Guilloche variant="band" :seed="next.id" class="coupon__band" />
    <div class="coupon__seal">
      <twig:Ui:Guilloche :seed="next.id" :progress="next.progress" :size="128" :animated="true" />
      <span class="coupon__percent"><strong>{{ next.progress }}</strong>%</span>
    </div>
    <div class="coupon__body">
      <h2 id="coupon-title">Votre synthèse est prête à être consultée.</h2>
      <p>{{ next.title }}</p>
      <p class="coupon__meta"><twig:Ui:Status :tone="next.status.tone" :text="next.status.label" /><span class="ui-serial">N° {{ next.reference }}</span></p>
    </div>
    <div class="coupon__actions">
      <twig:Ui:Button href="{{ path('app_document_show', { id: (documents|first).id }) }}" size="lg">Consulter la synthèse</twig:Ui:Button>
      <a class="ui-link" href="{{ path('app_mission_index', { selected: next.id }) }}">Voir la mission</a>
    </div>
  </section>

  <div class="overview-grid">
    <section class="overview-grid__missions" aria-labelledby="overview-missions">
      <div class="section-head">
        <h2 id="overview-missions">Vos missions</h2>
        <a class="ui-link" href="{{ path('app_mission_index') }}">Toutes les missions</a>
      </div>
      <twig:Mission:MissionList :missions="missions" />
    </section>

    <aside class="overview-grid__side">
      <section class="advisor sheet" aria-labelledby="advisor-name">
        <div class="advisor__who">
          <span class="advisor__avatar" aria-hidden="true">CM</span>
          <div>
            <h2 id="advisor-name">Camille Martin</h2>
            <p>Votre interlocutrice sur 3 missions</p>
          </div>
        </div>
        <div class="advisor__meeting">
          <twig:Ui:Icon name="calendar" />
          <div>
            <strong>Prochain point</strong>
            <span class="ui-numeric">Mercredi 4 novembre, 10 h 30</span>
          </div>
        </div>
        <p class="advisor__note">Rendez-vous fictif, aucun appel programmé.</p>
      </section>

      <section class="recent sheet" aria-labelledby="recent-docs">
        <div class="section-head">
          <h2 id="recent-docs">Derniers documents</h2>
          <a class="ui-link" href="{{ path('app_document_index') }}">Tout voir</a>
        </div>
        <ul class="document-mini" role="list">
          {% for document in documents %}
            <li>
              <a href="{{ path('app_document_show', { id: document.id }) }}">
                <twig:Ui:Icon name="file" />
                <span><strong>{{ document.title }}</strong><small>{{ document.category }}, {{ document.addedOn|short_date }}</small></span>
                <twig:Ui:Icon name="chevron" class="document-mini__chevron" />
              </a>
            </li>
          {% endfor %}
        </ul>
      </section>
    </aside>
  </div>
{% endblock %}
