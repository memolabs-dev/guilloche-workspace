{% extends 'base.html.twig' %}
{% block title %}Documents{% endblock %}
{% block body %}
  <div class="page-head">
    <div>
      <h1>Documents</h1>
      <p>Votre bibliothèque : synthèses, contrats et comptes rendus, rangés par mission.</p>
    </div>
  </div>

  <div
    data-controller="documents"
    data-documents-loading-message-value="Chargement des documents…"
    data-action="turbo:before-fetch-request->documents#start turbo:before-fetch-response->documents#response turbo:fetch-request-error->documents#failure turbo:frame-missing->documents#missing turbo:frame-load->documents#loaded unhandledrejection@window->documents#handledRejection turbo:before-cache@document->documents#reset"
  >
    <div class="results-feedback" role="status" aria-live="polite" data-documents-target="feedback"></div>
    <div class="results-error" hidden data-documents-target="error" role="alert">
      <twig:Ui:Notice type="error" message="Impossible de charger les documents. Votre vue précédente est conservée." />
      <twig:Ui:Button intent="secondary" data-action="documents#retry">Réessayer</twig:Ui:Button>
    </div>

    <turbo-frame id="document-results" data-turbo-action="advance" data-documents-target="frame">
      <form class="filter-bar" action="{{ path('documents') }}" method="get" role="search" aria-label="Filtrer les documents">
        <twig:Ui:Field label="Rechercher un document" id="document-search">
          <input id="document-search" type="search" name="q" value="{{ query }}" maxlength="100" placeholder="Nom, mission ou catégorie" data-documents-target="search" />
        </twig:Ui:Field>
        <twig:Ui:Field label="Filtrer par mission" id="document-mission">
          <select id="document-mission" name="mission">
            <option value="">Toutes les missions</option>
            {% for mission in missions %}
              <option value="{{ mission.id }}" {{ missionFilter == mission.id ~ '' ? 'selected' : '' }}>{{ mission.title }}</option>
            {% endfor %}
          </select>
        </twig:Ui:Field>
        <div class="filter-bar__actions">
          <twig:Ui:Button type="submit">Rechercher</twig:Ui:Button>
          <button class="filter-clear" type="button" data-documents-target="clear" data-action="documents#clear" hidden>Effacer</button>
        </div>
      </form>

      <h2 class="sr-only">Votre bibliothèque</h2>
      <p class="results-summary" tabindex="-1" data-documents-target="summary">
        <strong>{{ documents|length }} document{{ documents|length > 1 ? 's' : '' }}</strong>{% if query %} pour « {{ query }} »{% endif %}
      </p>
      <div class="results-region">
        <div class="results-region__mask" hidden data-documents-target="skeleton"><twig:Ui:Skeleton :rows="5" /></div>
        <div data-documents-target="content">
          <twig:Document:DocumentList :documents="documents" :libraryFilters="{ q: query, mission: missionFilter }" />
        </div>
      </div>
    </turbo-frame>
  </div>
{% endblock %}
