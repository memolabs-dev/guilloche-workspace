{# Ui:Alert — message d'etat. type : info|success|warning|error.
   title et message sont des textes passes en props. Le composant est autonome :
   son icone est un SVG inline, il ne depend d aucune autre recette du kit. #}
{% props type = 'info', title = null, message = null %}
{% set icons = {
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.4h.01"/>',
  success: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.4 4.6-5.1"/>',
  warning: '<path d="M12 3.5 2.8 19.5h18.4zM12 10v4.5M12 17.2h.01"/>',
  error: '<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>'
} %}
<div {{ attributes.defaults({ class: 'ui-alert ui-alert--' ~ type, role: type == 'error' ? 'alert' : 'status' }) }}>
  <svg class="ui-alert__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ (icons[type] ?? icons.info)|raw }}</svg>
  <div class="ui-alert__content">
    {% if title %}<p class="ui-alert__title">{{ title }}</p>{% endif %}
    {% if message %}<p class="ui-alert__message">{{ message }}</p>{% endif %}
    {% block content %}{% endblock %}
  </div>
</div>
