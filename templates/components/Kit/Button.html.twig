{# Ui:Button — action ou navigation.
   variant : primary|secondary|outline|ghost|link|danger. Les props historiques
   intent et appearance restent acceptees et sont traduites vers un variant.
   Texte par le slot. Avec href : un lien, sinon un bouton. #}
{% props variant = null, intent = 'primary', appearance = 'solid', size = 'md', type = 'button', href = null, disabled = false, loading = false %}
{% set resolved = variant ?? (
  appearance == 'ghost' ? 'ghost' : (
  appearance == 'outline' ? 'outline' : (
  intent == 'danger' ? 'danger' : (
  intent == 'secondary' ? 'secondary' : (
  intent in ['outline', 'ghost', 'link'] ? intent : 'primary'))))
) %}
{% set tag = href ? 'a' : 'button' %}
{% set defaults = {
  class: 'ui-button ui-button--' ~ resolved ~ ' ui-button--' ~ size ~ (loading ? ' is-loading' : '')
}|merge(href ? { href: href } : { type: type, disabled: disabled or loading })|merge(loading and not href ? { 'aria-busy': 'true' } : {}) %}
<{{ tag }} {{ attributes.defaults(defaults) }}>
  {%- if loading -%}
    <svg class="ui-button__spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" opacity="0.25"/><path d="M21 12a9 9 0 0 0-9-9" stroke-linecap="round"/></svg>
  {%- endif -%}
  <span class="ui-button__label">{% block content %}{% endblock %}</span>
</{{ tag }}>
