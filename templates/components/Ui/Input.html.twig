{# Ui:Input — champ natif, état invalide et descriptions explicites #}
{% props id, type = 'text', name = null, placeholder = null, value = null, describedBy = null, invalid = false, disabled = false %}
<input {{ attributes.defaults({
  class: 'ui-input',
  type: type,
  id: id,
  name: name ?? false,
  placeholder: placeholder ?? false,
  value: value ?? false,
  'aria-describedby': describedBy ?? false,
  disabled: disabled
}|merge(invalid ? { 'aria-invalid': 'true' } : {})) }} />
