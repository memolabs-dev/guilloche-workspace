{# Mission:MissionList — chaque ligne mène à la sélection de la mission, filtres conservés. #}
{% props missions, filter = null, selectedId = null %}
<ol {{ attributes.defaults({ class: 'mission-list', role: 'list' }) }}>
  {% for mission in missions %}
    {% set isSelected = mission.id == selectedId %}
    <li class="mission-list__item mission-list__item--{{ mission.status.tone }}{{ isSelected ? ' is-selected' : '' }}">
      <a
        class="mission-list__link"
        href="{{ path('app_mission_index', (filter ? filter.toQuery : {})|merge({ selected: mission.id })) }}"
        aria-current="{{ isSelected ? 'true' : 'false' }}"
      >
        <twig:Ui:Guilloche :seed="mission.id" :progress="mission.progress" :size="44" class="mission-list__rosette" />
        <span class="mission-list__main">
          <span class="mission-list__title">{{ mission.title }}</span>
          <span class="mission-list__step">{{ mission.nextStep }}</span>
        </span>
        <span class="mission-list__state">
          <twig:Ui:Status :tone="mission.status.tone" :text="mission.status.label" />
          <span class="mission-list__percent">{{ mission.progress }} %</span>
        </span>
        <span class="mission-list__date"><span class="sr-only">Échéance </span>{{ mission.dueOn|short_date }}</span>
        <twig:Ui:Icon name="chevron" class="mission-list__chevron" />
      </a>
    </li>
  {% else %}
    <li class="mission-list__empty">
      <twig:Ui:RegionState state="empty" title="Aucune mission trouvée" message="Modifiez la recherche ou l’état pour retrouver vos dossiers." />
    </li>
  {% endfor %}
</ol>
